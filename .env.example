# Sao chép file này thành ".env" rồi điền key thật vào, KHÔNG commit file .env.

# API key miễn phí lấy tại https://alpaca.markets (đăng ký tài khoản "paper" —
# mở được ở hầu hết các nước, không cần nạp tiền, không cần công dân Mỹ).
# Sau khi đăng ký, vào trang Dashboard > mục "API Keys" để lấy 2 giá trị này.
# Dùng cho giá cổ phiếu Mỹ (Apple, Microsoft, Tesla...) — real-time qua feed IEX.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Cổng chạy server (tuỳ chọn, mặc định 3000).
PORT=3000
