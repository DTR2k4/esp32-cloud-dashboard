# Sao chép file này thành ".env" rồi điền key thật vào, KHÔNG commit file .env.

# API key miễn phí lấy tại https://finnhub.io/register (mất ~1 phút, không cần thẻ).
# Dùng cho giá cổ phiếu quốc tế (Apple, Microsoft, Tesla...).
FINNHUB_API_KEY=

# Cổng chạy server (tuỳ chọn, mặc định 3000).
PORT=3000
